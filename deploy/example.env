# /srv/workout-explorer/.env: owned by the deploy user, mode 0600, never committed (F-31 DP-6).
# Read by Compose (as the project .env) and by the app container. With notifications on it holds a secret.
# Unset or empty keys use the default shown; an invalid value stops `serve` at start (exit 2).

# Required: the site's public origin, as the operator's proxy serves it. No path, no trailing slash.
WORKOUT_EXPLORER_BASE_URL=https://workouts.example.org

# Storage cap in MB (1-1000000); keep it below free disk minus Docker's logs and one over-cap upload.
WORKOUT_EXPLORER_STORAGE_LIMIT_MB=1000
# Uploads processed at once (1-16). The memory cap in compose.yaml assumes the default 4.
WORKOUT_EXPLORER_MAX_CONCURRENT_UPLOADS=4
# Parser time limit in seconds (5-60). The runbook records the chosen value.
WORKOUT_EXPLORER_PARSE_TIMEOUT=10
# Uploads per hour: per IPv4 address, and per IPv6 /64 prefix (1-240 each).
WORKOUT_EXPLORER_UPLOADS_PER_HOUR_IPV4=60
WORKOUT_EXPLORER_UPLOADS_PER_HOUR_IPV6=60

# Report notifications through Pushover (off unless both are set; RUNBOOK.md, "Notifications").
# Both are 30 letters and digits. Also add compose.notify.yaml to COMPOSE_FILE, or app cannot reach Pushover.
#WORKOUT_EXPLORER_PUSHOVER_TOKEN=
#WORKOUT_EXPLORER_PUSHOVER_USER=

# Host directories (the same path is used inside the containers).
WX_DATA=/srv/workouts
WX_WEB=/srv/workout-explorer/web
# Where Caddy's plain HTTP port is published on the host. Your reverse proxy forwards here.
# Never a public address. A proxy in a container needs an address it can reach (see RUNBOOK.md).
WX_LISTEN=127.0.0.1:8088
# Addresses or CIDR prefixes (separated by spaces, not commas) whose X-Forwarded-For Caddy believes: your reverse proxy's source
# address as Caddy sees it. Unset: the Docker gateway of the edge network (10.250.0.1), which is
# right for a proxy on the host connecting to WX_LISTEN on 127.0.0.1.
#WX_TRUSTED_PROXIES=10.250.0.1

# Self-hosters only (RUNBOOK.md, sections 2 to 12): build and run the image from this checkout.
#COMPOSE_FILE=compose.yaml:compose.build.yaml
# With notifications, add the override (operator: compose.yaml:compose.notify.yaml).
#COMPOSE_FILE=compose.yaml:compose.build.yaml:compose.notify.yaml
