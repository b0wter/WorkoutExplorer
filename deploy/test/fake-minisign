#!/usr/bin/env python3
# Test double for minisign (F-52 test harness only; never installed on a server). Used by
# update_test.py when the distribution's minisign is not installed. Public keys and signatures are
# in minisign's own format (Ed25519, prehashed BLAKE2b-512 "ED" signatures with a global signature
# over the trusted comment); the secret key file is an unencrypted format of its own.
# Supports: -G -p <pub> -s <sec> [-W] | -S -s <sec> -m <file> [-x <sig>] [-t <comment>]
#           | -V [-q] (-P <key> | -p <pub>) -m <file> [-x <sig>]
import base64, hashlib, os, sys, time
from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


args, opts = sys.argv[1:], {}
i = 0
while i < len(args):
    a = args[i]
    if a in ("-G", "-S", "-V", "-q", "-W", "-H"):
        opts[a] = True
    elif a in ("-p", "-P", "-s", "-m", "-x", "-t"):
        if i + 1 >= len(args):
            die("missing value for " + a)
        opts[a] = args[i + 1]
        i += 1
    else:
        die("unsupported argument " + a)
    i += 1


def b64line(path, n):
    with open(path) as f:
        lines = f.read().split("\n")
    return base64.b64decode(lines[n], validate=True)


if "-G" in opts:
    sk = Ed25519PrivateKey.generate()
    pk = sk.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    kid = os.urandom(8)
    seed = sk.private_bytes_raw()
    with open(opts["-p"], "w") as f:
        f.write("untrusted comment: minisign public key %s\n%s\n" % (kid[::-1].hex().upper(), base64.b64encode(b"Ed" + kid + pk).decode()))
    with open(opts["-s"], "w") as f:
        f.write("untrusted comment: fake minisign secret key (tests only)\n%s\n" % base64.b64encode(b"Ed" + kid + seed).decode())
elif "-S" in opts:
    raw = b64line(opts["-s"], 1)
    kid, sk = raw[2:10], Ed25519PrivateKey.from_private_bytes(raw[10:42])
    msg = open(opts["-m"], "rb").read()
    sig = sk.sign(hashlib.blake2b(msg, digest_size=64).digest())
    tc = opts.get("-t", "timestamp:%d\tfile:%s\thashed" % (time.time(), os.path.basename(opts["-m"])))
    gsig = sk.sign(sig + tc.encode())
    with open(opts.get("-x", opts["-m"] + ".minisig"), "w") as f:
        f.write("untrusted comment: signature from minisign secret key\n%s\ntrusted comment: %s\n%s\n"
                % (base64.b64encode(b"ED" + kid + sig).decode(), tc, base64.b64encode(gsig).decode()))
elif "-V" in opts:
    try:
        pub = base64.b64decode(opts["-P"], validate=True) if "-P" in opts else b64line(opts["-p"], 1)
        if len(pub) != 42 or pub[:2] != b"Ed":
            die("invalid public key")
        with open(opts.get("-x", opts["-m"] + ".minisig")) as f:
            lines = f.read().split("\n")
        s = base64.b64decode(lines[1], validate=True)
        if len(s) != 74 or not lines[2].startswith("trusted comment: "):
            die("invalid signature file")
        if s[2:10] != pub[2:10]:
            die("Signature key id in %s is different from public key" % opts.get("-x", "the signature"))
        msg = open(opts["-m"], "rb").read()
        if s[:2] == b"ED":
            msg = hashlib.blake2b(msg, digest_size=64).digest()
        elif s[:2] != b"Ed":
            die("unsupported signature algorithm")
        k = Ed25519PublicKey.from_public_bytes(pub[10:])
        k.verify(s[10:], msg)
        k.verify(base64.b64decode(lines[3], validate=True), s[10:] + lines[2][len("trusted comment: "):].encode())
    except (InvalidSignature, ValueError, IndexError, OSError):
        die("Signature verification failed")
    if "-q" not in opts:
        print("Signature and comment signature verified")
else:
    die("usage: fake-minisign -G|-S|-V ...")
